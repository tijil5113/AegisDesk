# Copy this file to .env and fill in real values. Never commit .env.

# --- Core ---
# NODE_ENV=production
# PORT=3000
# Public site origin if the API is on a different host (same-origin by default)
# ALLOWED_ORIGIN=https://your-domain.example

# --- Database (PostgreSQL) ---
# Required for account sign-up / password login.
# Railway: add a PostgreSQL plugin and use the provided DATABASE_URL.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DB
# PGSSL=true
# PG_POOL_MAX=8

# After setting DATABASE_URL, apply schema:
# npm run migrate

# --- Authentication ---
# Recommended when the access-code gate is used.
# SESSION_SECRET=replace-with-a-long-random-secret

# Optional private-deployment allowlist. If set, only these emails can
# create accounts or use the access-code gate.
# LOGIN_ALLOWED_EMAILS=user@example.com
# LOGIN_ACCESS_CODE=replace-with-a-long-random-code

# --- Optional providers (public site still works if these are unset) ---
# OPENAI_API_KEY=
# OPEN_API=
# NEWS_API_KEY=
# GNEWS_API_KEY=
# YOUTUBE_API_KEY=

# Mail — Resend (server-side only)
# RESEND_API_KEY=replace-with-resend-api-key
# MAIL_FROM=AegisDesk <onboarding@resend.dev>
# MAIL_REPLY_TO=hello@example.com
# MAIL_FOUNDER_NAME=Monish Tijil
# MAIL_APP_URL=https://your-public-aegisdesk-url.example
# RESEND_WEBHOOK_SECRET=replace-with-resend-webhook-secret

# Optional future mailbox OAuth (unused by Resend send)
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# OUTLOOK_CLIENT_ID=
# OUTLOOK_CLIENT_SECRET=
