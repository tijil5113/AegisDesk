# Copy this file to .env and fill in real values. Never commit .env.

# Login gate (required for production login.html)
# Comma-separated lowercase emails
LOGIN_ALLOWED_EMAILS=user@example.com
LOGIN_ACCESS_CODE=replace-with-a-long-random-code
SESSION_SECRET=replace-with-a-long-random-secret

# Optional: restrict CORS to a specific frontend origin
# ALLOWED_ORIGIN=https://your-domain.example

# OpenAI (server-side only)
# OPENAI_API_KEY=
# Optional alias if OPENAI_API_KEY is unset:
# OPEN_API=

# News
# NEWS_API_KEY=
# GNEWS_API_KEY=

# YouTube Data API (restricted by HTTP referrer / IP in Google Cloud Console)
# YOUTUBE_API_KEY=

# Mail — Resend (server-side only). Never put the API key in frontend code.
RESEND_API_KEY=replace-with-resend-api-key
MAIL_FROM=AegisDesk <onboarding@resend.dev>
# MAIL_REPLY_TO=hello@example.com
# MAIL_FOUNDER_NAME=Monish Tijil
# MAIL_APP_URL=https://your-public-aegisdesk-url.example

# Optional future webhook verification (do not enable an unsigned webhook)
# RESEND_WEBHOOK_SECRET=replace-with-resend-webhook-secret

# Optional future mailbox OAuth (server-side only; unused by Resend send)
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# OUTLOOK_CLIENT_ID=
# OUTLOOK_CLIENT_SECRET=
